---
import { proof } from "../content/site";
---

{proof.show && (
  <section
    data-testid="proof-strip"
    aria-label="Athlete Index by the numbers"
    class="border-line bg-surface border-y"
  >
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
      <ul class="grid gap-8 text-center sm:grid-cols-3">
        {proof.stats.map((stat) => (
          <li
            data-testid="proof-stat"
            data-placeholder={String(stat.placeholder)}
          >
            <p
              class:list={[
                "font-display text-2xl font-black italic sm:text-3xl",
                stat.placeholder
                  ? "border-accent text-accent inline-block rounded border border-dashed px-2"
                  : "text-white",
              ]}
            >
              {stat.value}
            </p>
            <p class="text-muted mt-2 text-sm">{stat.label}</p>
          </li>
        ))}
      </ul>
      {proof.stats.some((stat) => stat.placeholder) && (
        <p
          data-testid="placeholder-note"
          class="text-muted mt-6 text-center text-xs"
        >
          {proof.note}
        </p>
      )}
    </div>
  </section>
)}
