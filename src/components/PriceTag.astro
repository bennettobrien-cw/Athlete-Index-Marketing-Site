---
interface Props {
  price: string;
  period: string;
  testId: string;
  class?: string;
}

const { price, period, testId, class: className } = Astro.props;
const isPlaceholder = price.startsWith("[");
---

<p data-testid={testId} class:list={["items-baseline gap-1", className]}>
  <span
    data-placeholder={String(isPlaceholder)}
    class:list={[
      "font-display text-5xl font-black italic",
      isPlaceholder &&
        "border-accent text-accent rounded border border-dashed px-2 text-3xl",
    ]}
  >
    {price}
  </span>
  <span class="text-muted">{period}</span>
</p>
