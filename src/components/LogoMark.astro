---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 100 100" aria-hidden="true">
  <circle
    cx="50"
    cy="57"
    r="35"
    fill="none"
    stroke="currentColor"
    stroke-width="9"
  ></circle>
  <rect x="40" y="4" width="20" height="9" rx="2" fill="currentColor"></rect>
  <rect x="46" y="11" width="8" height="9" fill="currentColor"></rect>
  <rect
    x="78"
    y="17"
    width="9"
    height="13"
    rx="2"
    transform="rotate(45 82.5 23.5)"
    fill="currentColor"
  ></rect>
  <polygon
    points="56,30 38,60 50,60 43,84 64,52 52,52 60,30"
    class="fill-accent"
  ></polygon>
</svg>
