---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ProofStrip from "../components/ProofStrip.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Features from "../components/Features.astro";
import Audiences from "../components/Audiences.astro";
import Safety from "../components/Safety.astro";
import Testimonials from "../components/Testimonials.astro";
import PricingPreview from "../components/PricingPreview.astro";
import { pages, product } from "../content/site";
import { config } from "../config";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: product.name,
      url: config.siteUrl,
      logo: new URL("logo.svg", config.siteUrl).href,
    },
    { "@type": "WebSite", name: product.name, url: config.siteUrl },
    {
      "@type": "SoftwareApplication",
      name: product.name,
      url: config.appUrl,
      applicationCategory: "SportsApplication",
      operatingSystem: "Web",
      description: product.summary,
    },
  ],
};
---

<BaseLayout {...pages.home}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
  <main>
    <Hero />
    <ProofStrip />
    <HowItWorks />
    <Features />
    <Audiences />
    <Safety />
    <Testimonials />
    <PricingPreview />
  </main>
</BaseLayout>
