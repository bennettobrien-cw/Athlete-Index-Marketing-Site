---
import { safety } from "../content/site";

interface Props {
  showLink?: boolean;
}

const { showLink = true } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section aria-labelledby="safety-heading" class="bg-paper text-ink">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-28">
    <h2 id="safety-heading" class="text-4xl sm:text-5xl">
      {safety.heading}
    </h2>
    <p class="mt-4 max-w-xl text-lg text-black/70">{safety.intro}</p>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {safety.items.map((item) => (
        <li class="rounded-2xl border border-black/10 bg-white p-6">
          <p class="text-accent-deep text-lg font-bold">✓ {item.title}</p>
          <p class="mt-2 text-black/70">{item.body}</p>
        </li>
      ))}
    </ul>

    <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p data-testid="min-age-policy" class="font-medium">
        {safety.minAgePolicy}
      </p>
      {showLink && (
        <a
          href={`${base}parents/`}
          data-testid="parents-link"
          class="text-accent-deep inline-flex items-center gap-2 py-2 font-bold whitespace-nowrap hover:underline"
        >
          {safety.parentsLink} <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </div>
</section>
