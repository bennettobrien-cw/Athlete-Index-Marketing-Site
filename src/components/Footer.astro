---
import LogoMark from "./LogoMark.astro";
import { footer, product } from "../content/site";

const base = import.meta.env.BASE_URL;
---

<footer class="border-line bg-surface border-t">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-4">
    <div>
      <LogoMark class="h-10 w-10" />
      <p class="text-muted mt-4 text-sm">{footer.tagline}</p>
    </div>

    {footer.groups.map(({ heading, links }) => (
      <nav aria-label={heading}>
        <p class="text-sm font-bold tracking-widest text-white uppercase">
          {heading}
        </p>
        <ul class="mt-3 space-y-1 text-sm">
          {links.map(({ label, path }) => (
            <li>
              <a
                href={`${base}${path}`}
                class="text-muted hover:text-accent inline-block py-1.5"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="border-line border-t">
    <div class="text-muted mx-auto flex max-w-7xl flex-col gap-2 px-4 py-6 text-xs sm:px-6 md:flex-row md:justify-between">
      <p data-testid="ncaa-disclaimer">{footer.disclaimer}</p>
      <p data-testid="copyright">
        {`© ${new Date().getFullYear()} ${product.name}`}
      </p>
    </div>
  </div>
</footer>
