---
interface Props {
  id: string;
  heading: string;
  items: { question: string; answer: string }[];
}

const { id, heading, items } = Astro.props;
---

<section
  aria-labelledby={`${id}-heading`}
  class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:py-28"
>
  <h2 id={`${id}-heading`} class="text-4xl sm:text-5xl">
    {heading}
  </h2>

  <div class="divide-line border-line mt-10 divide-y border-y">
    {items.map((item) => (
      <details data-testid="faq-item" class="group">
        <summary
          data-testid="faq-question"
          class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-bold [&::-webkit-details-marker]:hidden"
        >
          {item.question}
          <span
            aria-hidden="true"
            class="text-accent text-2xl transition-transform group-open:rotate-45"
          >
            +
          </span>
        </summary>
        <p data-testid="faq-answer" class="text-muted pb-6 text-lg">
          {item.answer}
        </p>
      </details>
    ))}
  </div>
</section>
