---
import FeatureVisual from "./FeatureVisual.astro";
import { features } from "../content/site";

const base = import.meta.env.BASE_URL;
---

<section
  data-testid="features"
  aria-labelledby="features-heading"
  class="border-line bg-surface/40 border-y"
>
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-28">
    <h2 id="features-heading" class="text-4xl sm:text-5xl">
      {features.heading}
    </h2>
    <p class="text-muted mt-4 max-w-xl text-lg">{features.intro}</p>

    <div class="mt-16 space-y-20">
      {features.items.map((feature, index) => (
        <article
          data-testid={`feature-${feature.id}`}
          class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2"
        >
          <div class:list={[index % 2 === 1 && "lg:order-2"]}>
            <p class="text-accent flex items-center gap-2 text-sm font-bold tracking-widest uppercase">
              {feature.kicker}
              {"aiLabel" in feature && (
                <span
                  data-testid="ai-label"
                  class="bg-accent text-ink rounded px-1.5 py-0.5 text-xs tracking-normal"
                >
                  {feature.aiLabel}
                </span>
              )}
            </p>
            <h3 class="mt-3 text-3xl sm:text-4xl">{feature.title}</h3>
            <p class="text-muted mt-4 text-lg">{feature.body}</p>
            <ul class="mt-6 space-y-2">
              {feature.points.map((point) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="text-accent font-bold">
                    ✓
                  </span>
                  {point}
                </li>
              ))}
            </ul>
          </div>
          <div class="flex justify-center">
            <FeatureVisual feature={feature.id} />
          </div>
        </article>
      ))}
    </div>

    <a
      href={`${base}features/`}
      data-testid="features-link"
      class="text-accent mt-16 inline-flex items-center gap-2 py-2 text-lg font-bold hover:underline"
    >
      {features.linkLabel} <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
