---
interface Props {
  feature: string;
}

const { feature } = Astro.props;
const card = "border-line bg-surface rounded-2xl border p-5";
---

<div aria-hidden="true" class="w-full max-w-md">
  {feature === "profiles" && (
    <div class={card}>
      <p class="text-muted text-xs font-bold tracking-widest uppercase">
        Measurables
      </p>
      <ul class="mt-3 grid grid-cols-2 gap-2 text-sm">
        <li class="bg-ink rounded-lg p-3">
          Height <b class="block text-lg">6'1"</b>
        </li>
        <li class="bg-ink rounded-lg p-3">
          Weight <b class="block text-lg">185 lb</b>
        </li>
        <li class="bg-ink rounded-lg p-3">
          Wingspan <b class="block text-lg">6'4"</b>
        </li>
        <li class="bg-ink rounded-lg p-3">
          Class <b class="block text-lg">2028</b>
        </li>
      </ul>
    </div>
  )}
  {feature === "results" && (
    <div class={`${card} space-y-3`}>
      {[
        ["Exit velocity", "92 mph", true],
        ["60-yard dash", "6.71s", true],
        ["Pop time", "1.98s", false],
      ].map(([event, value, verified]) => (
        <div class="bg-ink flex items-center justify-between rounded-lg p-3">
          <span class="text-muted text-sm">{event}</span>
          <span class="font-bold">{value}</span>
          <span
            class={
              verified ? "text-accent text-xs font-bold" : "text-muted text-xs"
            }
          >
            {verified ? "✓ Verified" : "Self-reported"}
          </span>
        </div>
      ))}
    </div>
  )}
  {feature === "highlights" && (
    <div class={card}>
      <div class="from-accent/30 to-ink relative grid aspect-video place-items-center rounded-xl bg-gradient-to-br">
        <span class="bg-accent text-ink grid h-14 w-14 place-items-center rounded-full text-xl">
          ▶
        </span>
        <span class="absolute bottom-3 left-3 text-sm font-bold">
          Summer showcase reel
        </span>
        <span class="text-muted absolute right-3 bottom-3 text-xs">1:48</span>
      </div>
      <div class="mt-3 grid grid-cols-3 gap-2">
        <div class="bg-ink aspect-video rounded-md"></div>
        <div class="bg-ink aspect-video rounded-md"></div>
        <div class="bg-ink aspect-video rounded-md"></div>
      </div>
    </div>
  )}
  {feature === "discovery" && (
    <div class={card}>
      <div class="flex flex-wrap gap-2 text-xs font-bold">
        {["Basketball", "Class of 2027", "Guard", 'Vertical 32"+'].map(
          (filter) => (
            <span class="border-accent text-accent rounded-full border px-3 py-1">
              {filter}
            </span>
          ),
        )}
      </div>
      <ul class="mt-4 space-y-2 text-sm">
        {[
          ["AR", "Point guard · 2027"],
          ["MK", "Shooting guard · 2027"],
          ["TS", "Combo guard · 2027"],
        ].map(([initials, detail]) => (
          <li class="bg-ink flex items-center gap-3 rounded-lg p-3">
            <span class="bg-line grid h-8 w-8 place-items-center rounded-md text-xs font-bold">
              {initials}
            </span>
            <span>{detail}</span>
            <span class="text-accent ml-auto text-xs font-bold">View</span>
          </li>
        ))}
      </ul>
    </div>
  )}
  {feature === "ai" && (
    <div class={`${card} space-y-3 text-sm`}>
      <p class="bg-ink ml-auto w-4/5 rounded-2xl rounded-br-sm p-3">
        Help me email a D2 coach about my new 40 time.
      </p>
      <p class="bg-accent/15 w-4/5 rounded-2xl rounded-bl-sm p-3">
        Here's a short draft. Lead with your 4.48, link your film, and ask about
        their summer camp.
      </p>
      <p class="text-muted text-xs">AI Assistant · drafts only, you hit send</p>
    </div>
  )}
</div>
