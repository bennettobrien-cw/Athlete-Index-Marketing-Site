---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlanCard from "../components/PlanCard.astro";
import { pages, plans, pricingPage } from "../content/site";
---

<BaseLayout {...pages.pricing}>
  <main>
    <section class="mx-auto max-w-5xl px-4 pt-16 pb-12 sm:px-6 lg:pt-24">
      <p class="text-accent text-sm font-bold tracking-widest uppercase">
        {pricingPage.eyebrow}
      </p>
      <h1 class="mt-4 text-4xl leading-[0.95] sm:text-6xl">
        {pricingPage.heading}
      </h1>
      <p class="text-muted mt-6 max-w-2xl text-lg">{pricingPage.intro}</p>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {plans.map((plan) => (
          <PlanCard plan={plan} />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
