---
import LogoMark from "./LogoMark.astro";
import { config } from "../config";
import { cta, nav } from "../content/site";

const base = import.meta.env.BASE_URL;
---

<header class="border-line bg-ink/90 sticky top-0 z-40 border-b backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-6 px-4 sm:px-6">
    <a
      href={base}
      aria-label="Athlete Index home"
      class="font-display flex items-center gap-2 text-lg font-black uppercase italic"
      style="font-stretch: 118%"
    >
      <LogoMark class="h-8 w-8" />
      <span>
        Athlete <span class="text-accent">Index</span>
      </span>
    </a>

    <nav aria-label="Main" class="ml-auto hidden md:block">
      <ul class="flex items-center gap-6 text-sm font-medium">
        {nav.map(({ label, path }) => (
          <li>
            <a href={`${base}${path}`} class="hover:text-accent py-2">
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-4 md:ml-0">
      <a
        href={config.appUrl}
        class="hover:text-accent hidden py-2 text-sm font-medium sm:inline"
      >
        Log in
      </a>
      <a
        href={config.signupUrl}
        class="bg-accent text-ink hover:bg-accent-hover rounded-md px-4 py-2 text-sm font-bold"
      >
        {cta.primary}
      </a>
    </div>
  </div>
</header>
