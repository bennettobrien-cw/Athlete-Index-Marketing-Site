---
import { config } from "../config";
import type { plans } from "../content/site";

interface Props {
  plan: (typeof plans)[number];
}

const { plan } = Astro.props;
const base = import.meta.env.BASE_URL;
const href =
  plan.cta.to === "signup" ? config.signupUrl : `${base}${plan.cta.to}`;
const isPlaceholder = (value: string) => value.startsWith("[");
---

<article
  data-testid={`plan-${plan.id}`}
  aria-labelledby={`plan-${plan.id}-name`}
  class:list={[
    "flex flex-col rounded-2xl border p-6 sm:p-8",
    plan.featured ? "border-accent bg-surface" : "border-line bg-surface/60",
  ]}
>
  <h3 id={`plan-${plan.id}-name`} class="text-3xl">
    {plan.name}
  </h3>
  <p class="text-muted mt-1">{plan.audience}</p>

  <p class="mt-6 flex items-baseline gap-1">
    <span
      data-placeholder={String(isPlaceholder(plan.price))}
      class:list={[
        "font-display text-5xl font-black italic",
        isPlaceholder(plan.price) &&
          "border-accent text-accent rounded border border-dashed px-2 text-3xl",
      ]}
    >
      {plan.price}
    </span>
    <span class="text-muted">{plan.period}</span>
  </p>
  <p class="text-muted mt-1 text-sm">{plan.alternative}</p>

  <ul class="mt-6 flex-1 space-y-2">
    {plan.features.map((feature) => (
      <li class="flex gap-3">
        <span aria-hidden="true" class="text-accent font-bold">
          ✓
        </span>
        {feature}
      </li>
    ))}
  </ul>

  <a
    href={href}
    data-testid="plan-cta"
    data-cta={plan.cta.to === "signup" ? `pricing-${plan.id}` : undefined}
    class:list={[
      "mt-8 rounded-md px-6 py-3 text-center font-bold",
      plan.featured
        ? "bg-accent text-ink hover:bg-accent-hover"
        : "border-line border hover:border-white",
    ]}
  >
    {plan.cta.label}
  </a>
  <p data-testid="trial-terms" class="text-muted mt-3 text-center text-sm">
    {plan.terms}
  </p>
</article>
