---
import LogoMark from "./LogoMark.astro";
import { config } from "../config";
import { cta, nav } from "../content/site";

const base = import.meta.env.BASE_URL;
---

<header class="border-line bg-ink/90 sticky top-0 z-40 border-b backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:gap-6 sm:px-6">
    <a
      href={base}
      aria-label="Athlete Index home"
      class="font-display flex shrink-0 items-center gap-2 text-lg font-black whitespace-nowrap uppercase italic"
      style="font-stretch: 118%"
    >
      <LogoMark class="h-8 w-8" />
      <span class="hidden sm:inline">
        Athlete <span class="text-accent">Index</span>
      </span>
    </a>

    <nav aria-label="Main" class="ml-auto hidden md:block">
      <ul class="flex items-center gap-6 text-sm font-medium">
        {nav.map(({ label, path }) => (
          <li>
            <a href={`${base}${path}`} class="hover:text-accent py-2">
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-3 sm:gap-4 md:ml-0">
      <a
        href={config.appUrl}
        class="hover:text-accent hidden py-2 text-sm font-medium sm:inline"
      >
        Log in
      </a>
      <a
        href={config.signupUrl}
        data-cta="header"
        class="bg-accent text-ink hover:bg-accent-hover rounded-md px-4 py-2 text-sm font-bold whitespace-nowrap"
      >
        {cta.primary}
      </a>
      <button
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="border-line rounded-md border px-3 py-2 text-sm font-medium md:hidden"
        data-menu-button
      >
        Menu
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Mobile"
    class="border-line border-t px-4 pb-4 md:hidden"
    hidden
  >
    <ul class="flex flex-col text-base font-medium">
      {[...nav, { label: "Log in", href: config.appUrl }].map((item) => (
        <li>
          <a
            href={"href" in item ? item.href : `${base}${item.path}`}
            class="hover:text-accent block py-3"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const button =
    document.querySelector<HTMLButtonElement>("[data-menu-button]")!;
  const menu = document.getElementById("mobile-nav")!;

  function setOpen(open: boolean) {
    button.setAttribute("aria-expanded", String(open));
    menu.hidden = !open;
  }

  button.addEventListener("click", () =>
    setOpen(button.getAttribute("aria-expanded") !== "true"),
  );
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !menu.hidden) {
      setOpen(false);
      button.focus();
    }
  });
</script>
