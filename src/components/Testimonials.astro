---
import { testimonials } from "../content/site";
---

{testimonials.show && (
  <section
    aria-labelledby="testimonials-heading"
    class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-28"
  >
    <h2 id="testimonials-heading" class="text-4xl sm:text-5xl">
      {testimonials.heading}
    </h2>
    {testimonials.items.some((item) => item.placeholder) && (
      <p data-testid="placeholder-note" class="text-muted mt-4 text-sm">
        {testimonials.note}
      </p>
    )}

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {testimonials.items.map((item) => (
        <figure
          data-placeholder={String(item.placeholder)}
          class:list={[
            "bg-surface rounded-2xl p-6",
            item.placeholder
              ? "border-accent border border-dashed"
              : "border-line border",
          ]}
        >
          <blockquote class="text-lg">“{item.quote}”</blockquote>
          <figcaption class="mt-6">
            <p class="font-bold">{item.name}</p>
            <p class="text-muted text-sm">{item.detail}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}
