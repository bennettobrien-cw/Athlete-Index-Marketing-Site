---
import { config } from "../config";
import { cta, finalCta, trialTerms } from "../content/site";
---

<section data-testid="final-cta" class="bg-accent text-ink overflow-hidden">
  <div class="mx-auto flex max-w-7xl flex-col items-start gap-8 px-4 py-20 sm:px-6 lg:flex-row lg:items-end lg:justify-between lg:py-24">
    <div class="max-w-3xl">
      <h2 class="text-4xl sm:text-6xl">{finalCta.heading}</h2>
      <p class="mt-4 text-lg font-medium">{finalCta.body}</p>
    </div>
    <div class="flex w-full flex-col gap-3 sm:w-auto">
      <a
        href={config.signupUrl}
        data-cta="final"
        class="bg-ink hover:bg-surface rounded-md px-8 py-4 text-center text-lg font-bold text-white"
      >
        {cta.primary}
      </a>
      <p data-testid="trial-terms" class="text-sm font-medium">
        {trialTerms}
      </p>
    </div>
  </div>
</section>
