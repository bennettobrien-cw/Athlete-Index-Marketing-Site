---
import { howItWorks } from "../content/site";
---

<section
  id="how-it-works"
  aria-labelledby="how-it-works-heading"
  class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-28"
>
  <h2 id="how-it-works-heading" class="text-4xl sm:text-5xl">
    {howItWorks.heading}
  </h2>
  <p class="text-muted mt-4 max-w-xl text-lg">{howItWorks.intro}</p>

  <ol class="mt-12 grid gap-6 md:grid-cols-3">
    {howItWorks.steps.map((step, index) => (
      <li class="border-line bg-surface relative overflow-hidden rounded-2xl border p-6">
        <span
          aria-hidden="true"
          class="font-display text-accent/20 absolute -top-4 right-2 text-9xl font-black italic"
        >
          {index + 1}
        </span>
        <p class="text-accent text-sm font-bold tracking-widest uppercase">
          Step {index + 1}
        </p>
        <h3 class="mt-2 text-2xl">{step.title}</h3>
        <p class="text-muted mt-3">{step.body}</p>
      </li>
    ))}
  </ol>
</section>
