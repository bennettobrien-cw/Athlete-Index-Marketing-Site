---
import BaseLayout from "../layouts/BaseLayout.astro";
import { cta, pages } from "../content/site";
import { config } from "../config";

const { heading, body, homeLabel, ...meta } = pages.notFound;
---

<BaseLayout {...meta}>
  <main class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-32">
    <p class="font-display text-accent text-7xl font-black italic sm:text-9xl">
      404
    </p>
    <h1 class="mt-4 text-4xl sm:text-6xl">{heading}</h1>
    <p class="text-muted mt-4 text-lg">{body}</p>
    <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
      <a
        href={config.signupUrl}
        data-testid="not-found-signup"
        data-cta="not-found"
        class="bg-accent text-ink hover:bg-accent-hover rounded-md px-6 py-3 font-bold"
      >
        {cta.primary}
      </a>
      <a
        href={import.meta.env.BASE_URL}
        data-testid="not-found-home"
        class="border-line hover:border-accent rounded-md border px-6 py-3 font-bold"
      >
        {homeLabel}
      </a>
    </div>
  </main>
</BaseLayout>
